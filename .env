
# ==========================================
# APPLICATION
# ==========================================

APP_NAME="NOVA ADS STUDIO"
APP_ENV=development
DEBUG=true


# ==========================================
# DATABASE
# ==========================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nova_ads
DB_USERNAME=root
DB_PASSWORD=MyNewPassword123!
DB_CHARSET=utf8mb4

# Optional: override the automatically generated URL
DATABASE_URL=


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
LOG_FILE_NAME=nova_ads_studio.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5


# ==========================================
# STORAGE
# ==========================================

STORAGE_DIR=storage
INPUT_DIR=input
LOG_DIR=logs


# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# INTAKE SESSION
INTAKE_SESSION_TTL_SECONDS=86400